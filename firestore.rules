rules_version = '2';
// BioҰБТ — Cloud Firestore қауіпсіздік ережелері.
// Firebase Console → Firestore Database → Rules бөліміне толық көшіріп, Publish басыңыз.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().role == 'teacher'; }
    function unchanged(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();
      // Тіркелу: тек өзіне, тек «оқушы» рөлімен
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student' && request.resource.data.blocked == false;
      // Оқушы: рөлін, бұғатын өзгерте алмайды; құрылғыны тек бос болғанда бекітеді
      allow update: if isTeacher() || (
                      signedIn() && request.auth.uid == uid
                      && resource.data.blocked == false
                      && unchanged('role') && unchanged('blocked')
                      && (unchanged('deviceId') || resource.data.get('deviceId', '') == ''));
      allow delete: if isTeacher();
    }

    // Телефон нөмірі → email (нөмірмен кіру үшін). Тізімін ешкім ала алмайды.
    match /phones/{phone} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher();
    }

    // Айлық рейтинг
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isTeacher());
    }
  }
}
